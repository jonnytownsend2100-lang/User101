{
  "name": "mint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A money-generating app: sell a product, take payment, issue a license, watch the ledger. Zero dependencies.",
  "bin": { "mint": "./bin/mint.mjs" },
  "scripts": {
