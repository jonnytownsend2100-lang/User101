# Copy to .env (or export) before going live. Never commit real values.

# mock = simulated payments, offline, safe. stripe = real money.
MINT_PROVIDER=mock

# Required when MINT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...      # from the endpoint you create in Stripe

# Signs licence keys. Rotating this invalidates every key you have issued.
# MINT_LICENSE_SECRET=                  # openssl rand -hex 32

# Guards /dashboard, /api/metrics, /api/orders, /api/refund
# MINT_ADMIN_TOKEN=                     # openssl rand -hex 24

# Where the JSON store and generated dev secrets live
MINT_DATA_DIR=./mint-data

# Public origin, used to build checkout/success URLs
# MINT_BASE_URL=https://your-domain.example

PORT=8787

# Set to 0 in production so the simulated settlement endpoint is refused
MINT_ALLOW_MOCK=1
